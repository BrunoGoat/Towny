<?xml version="1.0" encoding="utf-8"?>
<!-- El botón de confirmar de una fila armada.

     Existe porque el paso de confirmar no se entendía. Era una palabra suelta
     al final de la fila —«OTRA VEZ»— y una palabra suelta se lee como una
     etiqueta que describe algo, no como una cosa que hay que pulsar: lo que
     contestaba era «¿otra vez qué?». Esto es un botón con forma de botón y un
     verbo dentro. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/towny_widget_accent" />
    <corners android:radius="999dp" />
</shape>
