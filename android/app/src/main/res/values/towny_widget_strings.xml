<!-- Lo poco que el cuadrito dice, en inglés: es lo que ve cualquier teléfono
     que no esté en español, igual que la app sin idioma elegido. El castellano
     está en values-es/. El cuadrito sigue el idioma del teléfono y no el que
     se elija dentro de la app: Android lo dibuja sin preguntarle a la app. -->
<resources>
    <string name="towny_widget_label">Towny</string>
    <string name="towny_widget_name">TOWNY</string>
    <!-- La descripción que se lee al elegirlo en la bandeja de widgets. -->
    <string name="towny_widget_about">Place a piece without opening the app.</string>
    <!-- El botón que aparece en una fila después del primer toque. -->
    <string name="towny_widget_confirm">Place piece</string>
    <string name="towny_widget_empty">Open Towny and found your first town.</string>
</resources>
