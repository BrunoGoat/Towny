<?xml version="1.0" encoding="utf-8"?>
<!-- El pueblo, en la pantalla de inicio.

     Seis filas escritas a mano y no una lista de verdad: el valle tiene seis
     solares y no va a tener siete, así que una lista con su servicio y su
     fábrica sería andamio para un número que ya sabemos. Las que sobran se
     esconden. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/towny_widget_card"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="8dp"
    android:paddingBottom="6dp">

    <!-- Antes de fundar no hay nada que tocar, y decirlo es mejor que un
         cuadro vacío que parece roto. -->
    <TextView
        android:id="@+id/towny_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textSize="14sp"
        android:textColor="@color/towny_widget_faint"
        android:text="@string/towny_widget_empty" />

    <!-- Fila 0: la marca, el nombre y cuántas van hoy. Toda ella se toca. -->
    <LinearLayout
        android:id="@+id/towny_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/towny_widget_row"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <ImageView
            android:id="@+id/towny_mark_0"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/towny_name_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="11dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="15sp"
            android:textColor="@color/towny_widget_ink" />

        <TextView
            android:id="@+id/towny_ask_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            android:textSize="11sp"
            android:letterSpacing="0.09"
            android:textAllCaps="true"
            android:textColor="@color/towny_widget_accent"
            android:text="@string/towny_widget_again" />

        <!-- Cuántas piezas lleva hoy ese pueblo. Un número y no un punto: lo
             que alguien quiere saber desde fuera no es sólo si apareció hoy,
             es cuánto lleva hecho. -->
        <TextView
            android:id="@+id/towny_count_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:minWidth="14dp"
            android:gravity="end"
            android:visibility="gone"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/towny_widget_accent" />

        <!-- Y cuando todavía no hay ninguna, el sitio vacío. Un anillo y no un
             cero: lo que dice es que el hueco está, no que hayas fallado. -->
        <ImageView
            android:id="@+id/towny_dot_0"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginStart="9dp"
            android:importantForAccessibility="no"
            android:src="@drawable/towny_widget_dot_off" />
    </LinearLayout>
